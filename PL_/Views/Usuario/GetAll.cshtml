    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model ML.Usuario

    <h1>GetAll</h1>



<div class="container">
    <div class="row align-items-start">
        <div class="col-9">
            <h2 class="text-bg-light">Usuarios</h2>
        </div>
        <div class="col-3 text-end">
            @*, new {IdUsuario=0}*@
            <a href="@Url.Action("Form","Usuarios" )" class="btn btn-success">
                Agregar usuarios <i class="bi bi-person-plus-fill"></i>
            </a>
        </div>
    </div>
</div>





<div id="OcultarVista">
    <div class="container">
        <div class="row">
            <div class="table-responsive">
                <table class="table table-hover">

                    <thead>
                        <tr>
                            <th scope="col">Eliminar</th>
                            <th scope="col">Actualizar</th>
                            <th scope="col">IdUsuario</th>
                            <th scope="col">Nombre</th>
                            <th scope="col">Username</th>
                            <th scope="col">Apellido paterno</th>
                            <th scope="col">Apellido materno</th>
                            <th scope="col">Email</th>
                            <th scope="col">Password</th>
                            <th scope="col">Sexo</th>
                            <th scope="col">Telefono</th>
                            <th scope="col">Celular</th>
                            <th scope="col">Fecha</th>
                            <th scope="col">CURP</th>
                            <th scope="col">Rol</th>

                            <th scope="col">Calle</th>
                            <th scope="col">Num interior</th>
                            <th scope="col">Num Exterior</th>
                            <th scope="col">Colonia</th>
                            <th scope="col">CP</th>
                            <th scope="col">Municipio</th>
                            <th scope="col">Estado</th>
                            <th scope="col">Imagen</th>
                            <th scope="col">Status</th>



                        </tr>
                    </thead>
                    <tbody>
                        @foreach (ML.Usuario usuario in Model.Usuarios)
                        {
                            <tr class="table-info">
                                <td>
                                    <a href="@Url.Action("Delete", "Usuarios", new { IdUsuario = usuario.IdUsuario })"
                                       class="btn btn-danger text-white"
                                       onclick="return confirm('Estas seguro de que deseas eliminar este usuario?');">
                                        <i class="bi bi-trash"></i>
                                        Delete
                                    </a>

                                </td>


                                <td>
                                    <a href="@Url.Action("Form", "Usuarios", new { IdUsuario = usuario.IdUsuario })"
                                       type="button" class="btn btn-primary" ;">
                                        <i class="bi bi-pencil-square"></i>
                                        Update
                                    </a>

                                </td>
                                <td>@usuario.IdUsuario</td>
                                <td>@usuario.Nombre</td>
                                <td>@usuario.UserName</td>
                                <td>@usuario.ApellidoPaterno</td>
                                <td>@usuario.ApellidoMaterno</td>
                                <td>@usuario.Email</td>
                                <td>@usuario.Password</td>
                                <td>@usuario.Sexo</td>
                                <td>@usuario.Telefono</td>
                                <td>@usuario.Celular</td>
                                <td>@usuario.Fecha</td>
                                <td>@usuario.CURP</td>
                                <td>@usuario.Rol.NombreR</td>

                                <td>@usuario.Direccion.Calle </td>
                                <td>@usuario.Direccion.NumeroInterior</td>
                                <td>@usuario.Direccion.NumeroExterior</td>
                                <td>@usuario.Direccion.Colonia.Nombre</td>
                                <td>@usuario.Direccion.Colonia.CodigoPostal</td>
                                <td>@usuario.Direccion.Colonia.Municipio.NombreMunicipio</td>
                                <td>@usuario.Direccion.Colonia.Municipio.Estado.NombreEstado</td>


                                @if (usuario.Imagen != null)
                                {

                                    <td>
                                        <img src="data:image/*;base64,@Convert.ToBase64String(usuario.Imagen)"
                                             class="img-fluid rounded img-thumbnail"
                                             style="max-width: 120px; height: auto;" alt="Img" />
                                    </td>
                                }


                                <td>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input status-switch" type="checkbox"
                                        @*role="switch"*@
                                               data-idusuario="@usuario.IdUsuario"
                                        @(usuario.Status ? "checked" : "") />
                                    </div>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>


    @section Scripts {
        <script>
            $(document).ready(function () {
                $('.status-switch').on('change', function () {
                    var IdUsuario = $(this).data('idusuario');
                    var nuevoEstado = $(this).is(':checked');

                    $.ajax({
                        url: '@Url.Action("CambiarStatus", "Usuarios")',
                        dataType: 'JSON',
                        method: 'POST',
                        data: { IdUsuario: IdUsuario, Status: nuevoEstado },
                        success: function (result) {
                            console.log(IdUsuario)
                            console.log(nuevoEstado)
                            if (result.success) {
                             //   alert('Status actualizado correctamente.');
                            } else {
                                alert('Error al actualizar el Status.');
                            }
                        },
                        error: function (ex) {
                            alert('Ocurrió un errroer.');
                        }
                    })
                })
            })
        </script>


    }
</div>
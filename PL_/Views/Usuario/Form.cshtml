                <br />
                <div>
                    @Html.LabelFor(Model => Model.Rol.IdRol, new { @class = "form-label" })
                    @Html.DropDownListFor(Model => Model.Rol.IdRol, new SelectList(Model.Rol.Roles, "IdRol", "NombreR"), "Selecciona una opcion", new { @class = "form-control bg-success text-white", required = "required" })

                    Por favor selecciona uno.
                </div>
                @Html.ValidationMessageFor(Model => Model.Sexo, "", new { @class = "badge bg-danger" })

                <br /> <br />
                <div>
                    @Html.LabelFor(Model => Model.Telefono, new { @class = "form-label" })
                    <i class="bi bi-telephone-fill text-primary"></i>
                    @Html.TextBoxFor(Model => Model.Telefono, new { @maxlength = "10", @class = "form-control sombra", placeholder = "Ingresa tu telefono", onkeypress = "validarNumero(this, event)", onblur = "validarNumero(this, event)", required = "required", id = "Telefono" })
                    <p class="invalid-feedback" hidden="hidden"></p>

                </div>
                @Html.ValidationMessageFor(Model => Model.Telefono, "", new { @class = "text-danger" })

                <br />
                <div>
                    @Html.LabelFor(Model => Model.Celular, new { @class = "form-label" })
                    <i class="bi bi-phone-fill text-primary"></i>
                    @Html.TextBoxFor(Model => Model.Celular, new { @maxlength = "10", @class = "form-control sombra", placeholder = "Ingresa tu celular", onkeypress = "validarNumero(this, event)", id = "Celular", onblur = "validarNumero(this, event)" })

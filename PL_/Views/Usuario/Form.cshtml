                        <i class="bi bi-geo-fill text-primary"></i>
                        @Html.DropDownListFor(Model => Model.Direccion.Colonia.IdColonia, new SelectList(Model.Direccion.Colonia.Colonias, "IdColonia", "Nombre"),
                                 "Seleccione una colonia", new { @class = "form-control bg-secondary text-white", @id = "ddlColonia", required = "required" })

                    var pass = document.getElementById('Contra').value;
                    var confirmPass = document.getElementById('Contra2').value;
                    var message = document.getElementById('message2');

                    if (pass && confirmPass) {
                        if (pass === confirmPass) {
                            $("#Contra2").addClass("is-valid");
                            $("#Contra2").removeClass("is-invalid");
                            message.textContent = 'Los password coinciden ✔️';

                        } else {
                            message.textContent = 'Los password no coinciden ❌';

                            event.preventDefault();
                            $("#Contra2").addClass("is-invalid");
                            $("#Contra2").removeClass("is-valid");
                        }

                    }
                    var email = document.getElementById('Email').value;
                    var confirmEmail = document.getElementById('Email2').value;
                    var message = document.getElementById('message');

                    if (email && confirmEmail) {
                        if (email === confirmEmail) {
                            $("#Email2").addClass("is-valid");
                            $("#Email2").removeClass("is-invalid");
                            message.textContent = 'Los correos coinciden ✔️';

                        } else {
                            message.textContent = 'Los correos no coinciden ❌';

                            event.preventDefault();
                            $("#Email2").addClass("is-invalid");
                            $("#Email2").removeClass("is-valid");
                        }

                    }
                }

                function validarUser(input, event) {
                    const regex = /^\S+$/;
                    var letra = event.key;

                    if (event.type == "keypress") {

                        if (regex.test(letra) && letra.length > 0) {
                            $(input).addClass("is-valid");
                            $(input).removeClass("is-invalid");
                        }
                        else {
                            event.preventDefault();
                            $(input).addClass("is-invalid");
                            $(input).removeClass("is-valid");

                        }
                    }
                    console.log($(input).val());
                    if (event.type == "blur") {
                        const regex = /^\S+$/;
                        if (regex.test($(input).val()) && $(input).val().length > 5) {
                            $(input).addClass("is-valid");
                            $(input).removeClass("is-invalid");
                        }
                        else {
                            event.preventDefault();
                            $(input).addClass("is-invalid");
                            $(input).removeClass("is-valid");

                        }
                    }
                }

                function validarFecha(input, event) {
                    const regex = /^(0[1-9]|[12][0-9]|3[01])\/(0[1-9]|1[0-2])\/(19[0-9]{2}|20[0-2][0-9])$/;
                    var letra = event.key;
                    if (event.type == "keypress") {
                        console.log(errorSpan)
                        if (regex.test(letra)) {
                            $(input).addClass("is-valid");
                            $(input).removeClass("is-invalid");
                        }
                        else {
                            event.preventDefault();
                            $(input).addClass("is-invalid");
                            $(input).removeClass("is-valid");

                        }
                    }
                    if (event.type == "blur") {
                        const regex = /^\S+$/;
                        if (regex.test($(input).val())) {
                            $(input).addClass("is-valid");
                            $(input).removeClass("is-invalid");
                        }
                        else {
                            event.preventDefault();
                            $(input).addClass("is-invalid");
                            $(input).removeClass("is-valid");

                        }
                    }
                }

                document.getElementById('togglePassword').addEventListener('click', function () {
                    const passwordInput = document.getElementById('Contra');
                    const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                    passwordInput.setAttribute('type', type);

                    this.querySelector('i').classList.toggle('bi-eye-fill');
                    this.querySelector('i').classList.toggle('bi-eye-slash-fill');
                });


                    //////Validar el formulario
                    (function () {
                        'use strict';

                        const form = document.getElementById('myForm');

                        form.addEventListener('submit', function (event) {
                            if (!form.checkValidity()) {
                                event.preventDefault();
                                event.stopPropagation();
                            }
                            form.classList.add('was-validated');
                        }, false);
                    })();

            </script>

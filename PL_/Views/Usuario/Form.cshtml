            <div class="col-4">
                @Html.LabelFor(Model => Model.Sexo, new { @class = "form-label" })
                <br />

                @Html.RadioButtonFor(Model => Model.Sexo, "H", new { required = "required" }) @Html.Label("H")
                @Html.RadioButtonFor(Model => Model.Sexo, "M", new { required = "required" }) @Html.Label("M")

                    <p class="invalid-feedback" hidden="hidden"></p>
                    @Html.ValidationMessageFor(Model => Model.Nombre, "", new { @class = "badge bg-danger" })
                </div>

                <br />
                <div>
                    @Html.LabelFor(Model => Model.UserName, new { @class = "form-label" })

                    @Html.TextBoxFor(Model => Model.ApellidoPaterno, new { @class = "form-control sombra", placeholder = "Ingresa el Apellido Paterno", id = "txtApellidoP", required = "required", onkeypress = "validarLetra(this, event)", onblur = "validarLetra(this, event)" })
                    <p class="invalid-feedback" hidden="hidden"></p>
                    @Html.ValidationMessageFor(Model => Model.ApellidoPaterno, "", new { @class = "badge bg-danger" })

                </div>
                <br />

                <div>
                    @Html.LabelFor(Model => Model.ApellidoMaterno, new { @class = "form-label" })
                    @Html.TextBoxFor(Model => Model.ApellidoMaterno, new { @class = "form-control sombra", placeholder = "Ingresa el Apellido Materno", id = "txtApellidoM", onkeypress = "validarLetra(this, event)", onblur = "validarLetra(this, event)" })
                    <p class="invalid-feedback" hidden="hidden"></p>
                    @Html.ValidationMessageFor(Model => Model.ApellidoMaterno, "", new { @class = "badge bg-danger" })

                </div>

                <br />
                <div>

                    @Html.LabelFor(Model => Model.Email, new { @class = "form-label" })
                    <i class="bi bi-envelope-fill text-primary"></i>
                    @Html.TextBoxFor(Model => Model.Email, new { @class = "form-control sombra", placeholder = "Ingresa el email", id = "Email", onblur = "validarEmail(this, event)", required = "required", @type = "email", @onpaste = "return false;" })
                    <div class="invalid-feedback">
                        Email invalido
                    </div>
                    @Html.ValidationMessageFor(Model => Model.Email, "", new { @class = "badge bg-danger" })
                    <div>
                        <br />
                        <label>Confirma tu correo </label>

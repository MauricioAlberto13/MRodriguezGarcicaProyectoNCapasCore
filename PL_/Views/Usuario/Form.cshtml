                    @Html.ValidationMessageFor(Model => Model.Celular, "", new { @class = "badge bg-danger" })

                </div>
                <br />
                <div>
                    @Html.LabelFor(Model => Model.Fecha, new { @class = "form-label" })
                    <i class="bi bi-calendar-date-fill text-primary"></i>
                    @Html.TextBoxFor(Model => Model.Fecha, new { @maxlength = "10", @class = "form-control sombra", placeholder = "Ingresa tu fecha de nacimiento", id = "FechaNacimiento", required = "required", @readonly = true })

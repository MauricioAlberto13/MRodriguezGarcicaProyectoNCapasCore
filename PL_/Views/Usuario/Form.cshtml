                        @Html.LabelFor(Model => Model.Direccion.Colonia.Colonias, new { @class = "form-label" })
                        <i class="bi bi-geo-fill text-primary"></i>
                        @Html.DropDownListFor(Model => Model.Direccion.Colonia.IdColonia, new SelectList(string.Empty, "IdColonia", "Nombre"),
                                 "Seleccione una colonia", new { @class = "form-control bg-secondary text-white", @id = "ddlColonia" })
                        <br />
                    }
                    @Html.LabelFor(Model => Model.Direccion.Calle, new { @class = "form-label" })
                    <i class="bi bi-signpost-fill text-primary"></i>
                    @Html.TextBoxFor(Model => Model.Direccion.Calle, new { @class = "form-control sombra", placeholder = "Ingresa tu calle", id = "txtCalle", onkeypress = "validarLetra(this, event)", required = "required", onblur = "validarLetra(this, event)" })
                    <p class="invalid-feedback" hidden="hidden"></p>
                    @Html.ValidationMessageFor(Model => Model.Direccion.Calle, "", new { @class = "badge bg-danger" })

                    <br />
                    <div>
                        @Html.LabelFor(Model => Model.Direccion.NumeroInterior, new { @class = "form-label" })
                        <i class="bi bi-123 text-primary"></i>
                        @Html.TextBoxFor(Model => Model.Direccion.NumeroInterior, new { @class = "form-control sombra", placeholder = "Ingresa tu Num. interior", @maxlength = "5", onkeypress = "validarNumeroCalle(this, event)", required = "required", onblur = "validarNumeroCalle(this, event)" })
                        <p class="invalid-feedback" hidden="hidden"></p>
                        @Html.ValidationMessageFor(Model => Model.Direccion.NumeroInterior, "", new { @class = "badge bg-danger" })

                    </div>
                    <br />
                    <div>
                        @Html.LabelFor(Model => Model.Direccion.NumeroExterior, new { @class = "form-label" })
                        <i class="bi bi-123 text-primary"></i>
                        @Html.TextBoxFor(Model => Model.Direccion.NumeroExterior, new { @class = "form-control sombra", placeholder = "Ingresa tu Num. Exterior", @maxlength = "5", onkeypress = "validarNumeroCalle(this, event)", onblur = "validarNumeroCalle(this, event)" })
                        <p class="invalid-feedback" hidden="hidden"></p>
                        @Html.ValidationMessageFor(Model => Model.Direccion.NumeroExterior, "", new { @class = "badge bg-danger" })

                    </div>
                </div>


            </div>
            <div class="row">
                <label for="imagen">Imagen </label>
                <input type="file" id="imagen" name="imagenUser" accept="image/*" onchange="CargarArchivo(event)" class="form-control" />
                <br />

                @Html.HiddenFor(Model => Model.Imagen)

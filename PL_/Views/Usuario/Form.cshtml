                        Ingresa una fecha de nacimiento real.
                    </div>
                    @Html.ValidationMessageFor(Model => Model.Fecha, "", new { @class = "badge bg-danger" })

                </div>
                <br />
                <div>
                    @Html.LabelFor(Model => Model.CURP, new { @class = "form-label" })
                    @Html.TextBoxFor(Model => Model.CURP, new { @class = "form-control sombra", placeholder = "Ingresa tu Curp", id = "CURP", @maxlength = "18", oninput = "this.value = this.value.toUpperCase()", onblur = "validarCurp(this, event)" })

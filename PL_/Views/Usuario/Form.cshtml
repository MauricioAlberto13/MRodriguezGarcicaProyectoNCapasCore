                        <span id="message"></span>

                    </div>
                </div>
                <br />
                <div>


                    @Html.LabelFor(Model => Model.Password, new { @class = "form-label" })
                    <i class="bi bi-alphabet  text-primary"></i>
                    <div class="input-group">
                        @Html.TextBoxFor(Model => Model.Password, new { @type = "password", @class = "form-control sombra", placeholder = "Ingresa tu password", required = "required", id = "Contra", onblur = "validarPassword(this, event)", @onpaste = "return false;" })


</style>

@using (Html.BeginForm("Form", "Usuario", FormMethod.Post, new { enctype = "multipart/form-data", id = "myForm", @class = "needs-validation", @novalidate = "novalidate" }))

{
    <div class="container">
        <div class="row">
            <div class="col-4">

@model ML.ProductoSucursal

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

<div class="container">
    <div class="row align-items-start">
        <div class="col-9">
            <h2 class="text-bg-light">Productos Sucursales</h2>
        </div>
    </div>
</div>

<div class="container">
    <div class="row">
        <div class="col-3">
            <button id="btnToggleVista" onclick="MostraV()" type="button" class="btn btn-primary w-100">
                <i class="bi bi-search"></i> Busqueda Abierta
            </button>
        </div>

    </div>
</div>


<div id="VistaFiltrar" class="d-none mt-4">
    <div class="container bg-light">
        @using (Html.BeginForm("GetAll", "Sucursal", FormMethod.Post))

        {
            <div class="row">

                <div class="col-3">
                    <label for="Categoria">Categoria</label>
                    @Html.DropDownListFor(Model => Model.Sucursal.IdSucursal,
                             new SelectList(Model.Sucursal.Sucursales, "IdSucursal", "Nombre"),
                             "Selecciona una Sucursal",
                             new { @class = "form-control", @id = "ddlCategoria", required = "required" })

                    <div class="invalid-feedback">Selecciona una sucursal</div>

                    @Html.ValidationMessageFor(Model => Model.Sucursal.IdSucursal, "", new { @class = "badge bg-danger" })
                </div>


               
                <div class="col-3">
                    <br />
                    <button type="submit" class="btn btn-outline-success w-100 form-control">
                        <i class="bi bi-search"></i> Buscar
                    </button>
                </div>

            </div>
        }
    </div>
</div>

<div id="OcultarVista">
    <div class="container">
        <div class="row">
            <div class="container">
                <div class="row align-items-start">
                    <div class="col-9">
                        <h2 class="text-bg-light d-none">Usuarios</h2>
                    </div>
                    <div class="col-3 text-end">
                        <a href="@Url.Action("Form","Producto" )" class="btn btn-success">
                            Agregar Productos <i class="bi bi-person-plus-fill"></i>
                        </a>
                    </div>
                </div>
            </div>


            @if (Model.IdProductoSucursal != null)
            {
                <div class="table-responsive">
                    <table class="table table-hover">

                        <thead>
                            <tr>
                               
                                <th scope="col">Actualizar</th>
                                <th scope="col">Imagen</th>
                                <th scope="col">Producto</th>
                                <th scope="col">Sucursal</th>
                                <th scope="col">Stock</th>
                                <th scope="col">Eliminar</th>




                            </tr>
                        </thead>
                        <tbody>


                            @foreach (ML.ProductoSucursal productoSucursal in Model.ProductoSucursales)
                            {

                                <tr class="table-info">



               <td>
                                        <button type="button"
                                                id="btnUpdateStock-@productoSucursal.IdProductoSucursal"    
                                                class="btn btn-primary"
                                                onclick="activarEdicion(@productoSucursal.IdProductoSucursal)">
                                            <i class="bi bi-pencil-square"></i> Update
                                        </button>
</td>



                                    @if (productoSucursal.Producto.Imagen != null)
                                    {

                                        <td>
                                            <img src="data:image/*;base64,@Convert.ToBase64String(productoSucursal.Producto.Imagen)"
                                                 class="img-fluid rounded img-thumbnail"
                                                 style="max-width: 80px; height: auto;" alt="Img" />
                                        </td>
                                    }
                                    else
                                    {
                                        <td>
                                            <img src="~/DProduct.jpg"
                                                 class="img-fluid rounded img-thumbnail"
                                                 style="max-width: 80px; height: auto;" alt="Img" />
                                        </td>

                                    } 

                                    <td>@productoSucursal.Producto.Nombre</td>
                                    <td>  @productoSucursal.Sucursal.Nombre</td>
                                    <td>
                                        <input type="number" 
                                            id="stock_@productoSucursal.IdProductoSucursal"
                                            value="@productoSucursal.Stock"       
                                            readonly="true"
                                               disabled="true"
                                            class="form-control d-inline-block w-75" />
               
                                    </td>
                                    <td>
                                        <button type="button"       
                                                class="btn btn-success d-none"       
                                                id="btnGuardarStock-@productoSucursal.IdProductoSucursal"       
                                                onclick="guardarStock(@productoSucursal.IdProductoSucursal)">
                                            <i class="bi bi-floppy2"></i>
                                            Guardar
                                        </button>

                                        <a href="@Url.Action("Delete", "Sucursal", new { IdProducto = productoSucursal.Producto.IdProducto})"
                                           class="btn btn-danger text-white"
                                           onclick="return confirm('Estas seguro de que deseas actualizatar el stock a 0 de este producto?');">
                                            <i class="bi bi-trash"></i>
                                            Delete
                                        </a>

                                    </td>
                          
                                </tr>
                            }

                        </tbody>
                    </table>

                </div>

            }
            else
            {
                <div class="col-9">
                    <h2 class="text-bg-light">Selecciona una categoria y una subcategoria para ver los productos</h2>
                </div>


            }
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    @section Scripts {

         <script>
             function activarEdicion(idProductoSucursal)
             {



                if ( $("#btnUpdateStock-" + idProductoSucursal).hasClass("btn btn-primary")) {

                  $("#btnUpdateStock-" + idProductoSucursal).removeClass("btn btn-primary")
                  $("#btnUpdateStock-" + idProductoSucursal).text(" Cancelar").addClass("btn btn-warning");

                   $("#btnUpdateStock-" + idProductoSucursal).prepend('<i class="bi bi-x-circle"></i>');
                  $("#stock_" + idProductoSucursal).prop("readonly", false);
                  $("#stock_" + idProductoSucursal).prop("disabled", false);
                  $("#btnGuardarStock-" + idProductoSucursal).removeClass("d-none");

                } else if($("#btnUpdateStock-" + idProductoSucursal).hasClass("btn btn-warning")) {
                                    $("#btnUpdateStock-" + idProductoSucursal).removeClass("btn btn-warning")

                  $("#btnUpdateStock-" + idProductoSucursal).text(" Update").addClass("btn btn-primary");
                  $("#btnUpdateStock-" + idProductoSucursal).prepend('<i class="bi bi-pencil-square"></i>');
                  $("#stock_" + idProductoSucursal).prop("readonly", true);
                  $("#stock_" + idProductoSucursal).prop("disabled", true);
                  $("#btnGuardarStock-" + idProductoSucursal).addClass("d-none");

                }
                else{

                     $("#btnUpdateStock-" + idProductoSucursal).text(" Update").addClass("btn btn-primary")
                    $("#stock_" + idProductoSucursal).prop("readonly", true);
                  $("#stock_" + idProductoSucursal).prop("disabled", true);
                  $("#btnGuardarStock-" + idProductoSucursal).addClass("d-none");

                }
           

            }

            function guardarStock(idProductoSucursal) {      
                var nuevoStock = $("#stock_" + idProductoSucursal).val();
                 $.ajax({ 
                     type: "POST",
                     url: '@Url.Action("UpdateStock", "Sucursal")',
                     data: { 
                         IdProductoSucursal: idProductoSucursal,                    
                         Stock: nuevoStock                
                     },
                    success: function () {
                        $("#stock_" + idProductoSucursal).prop("readonly", true);
                        $("#stock_" + idProductoSucursal).prop("disabled", true);


                        $("#btnGuardarStock-" + idProductoSucursal).addClass("d-none");

                        alert("El Stock ha sido actualizazdo correctamente ✅ ");
                    },
                    error: function () {
                                       $(".stock").prop("readonly", true);
                        alert("Error al actualizar el stock ❌");
                    }
                });
            }

            function MostraV() {
                var vistaFiltrar = document.getElementById("VistaFiltrar");
                //    var ocultarVista = document.getElementById("OcultarVista");
                var vistaCargar = document.getElementById("VistaCargar");
                var boton = document.getElementById("btnToggleVista");

                if (vistaFiltrar.classList.contains("d-none")) {

                    vistaFiltrar.classList.remove("d-none");
                    vistaCargar.classList.add("d-none");
                    //     ocultarVista.classList.add("d-none");

                } else {

                    vistaFiltrar.classList.add("d-none");
                    vistaCargar.classList.add("d-none");
                    //    ocultarVista.classList.remove("d-none");

                }
            }



            function MostraC() {
                var vistaFiltrar = document.getElementById("VistaFiltrar");
                //   var ocultarVista = document.getElementById("OcultarVista");
                var vistaCargar = document.getElementById("VistaCargar");
                var boton = document.getElementById("btnToggleCarga");

                if (vistaCargar.classList.contains("d-none")) {

                    vistaCargar.classList.remove("d-none");
                    vistaFiltrar.classList.add("d-none");
                    //   ocultarVista.classList.add("d-none");

                } else {

                    vistaCargar.classList.add("d-none");
                    vistaFiltrar.classList.add("d-none");
                    //    ocultarVista.classList.remove("d-none");

                }
            }





        </script>

    }
</div>

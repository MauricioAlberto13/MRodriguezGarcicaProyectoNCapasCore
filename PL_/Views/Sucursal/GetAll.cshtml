@model ML.ProductoSucursal

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="~/css/Sucursal.css">
<div id="OcultarVista">
    <div class="container">
        <div class="row">

            <div class="container">
                <div class="row">
                    <div class="col-9">
                     </div>
                    <div class="col-3">
                        <button id="btnToggleVista" onclick="MostraV()" type="button" class="btn btn-primary w-100">
                            <i class="bi bi-search"></i> Busqueda Abierta
                        </button>
                    </div>

                </div>
            </div>


             
        
                <div id="VistaFiltrar" class="d-none mt-4">
                    <div class="container bg-light">
                        @using (Html.BeginForm("GetAll", "Sucursal", FormMethod.Post))

                        {
                            <div class="row">
                           
                                <div class="col-4">
                                    <label for="Categoria">Categoria</label>
                                    @Html.DropDownListFor(Model => Model.Sucursal.IdSucursal,
                                             new SelectList(Model.Sucursal.Sucursales, "IdSucursal", "Nombre"),
                                             "Selecciona una Sucursal",
                                             new { @class = "form-control", @id = "ddlCategoria", required = "required" })

                                    <div class="invalid-feedback">Selecciona una sucursal</div>

                                    @Html.ValidationMessageFor(Model => Model.Sucursal.IdSucursal, "", new { @class = "badge bg-danger" })
                                </div>



                                <div class="col-4">
                                    <br />
                                    <button type="submit" class="btn btn-outline-success w-100 form-control">
                                        <i class="bi bi-search"></i> Buscar
                                    </button>
                                </div>
                                <div class="col-4">
                                </div>
                                  
                            </div>
                        }
                    </div>
                </div>




                </div>
            </div>
    <br />  
            @if (Model.IdProductoSucursal != null)
            {

                <!-- From Uiverse.io by EmmaxPlay -->
               
                <div class="card">
                    <div class="header">
                        <div class="top">
                            <div class="circle">
                                <span class="red circle2"></span>
                            </div>
                            <div class="circle">
                                <span class="yellow circle2"></span>
                            </div>
                            <div class="circle">
                                <span class="green circle2"></span>
                            </div>
                            <div class="title">
                                <p id="title2">style.css</p>
                            </div>
                        </div>
                    </div>

                    
                    <div class="card__content">

                        <div class="table-responsive">
                            <table class="table table-hover">

                                <thead>
                                    <tr>

                                        <th scope="col">Actualizar</th>
                                        <th scope="col">Imagen</th>
                                        <th scope="col">Producto</th>
                                        <th scope="col">Sucursal</th>
                                        <th scope="col">Stock</th>
                                        <th scope="col">Eliminar</th>




                                    </tr>
                                </thead>
                                <tbody>


                                    @foreach (ML.ProductoSucursal productoSucursal in Model.ProductoSucursales)
                                    {

                                        <tr class="table-info">



                                            <td>
                                                <button type="button"
                                                            class="btn btn-primary btn-update-stock"
                                                            id="btnUpdateStock-@productoSucursal.IdProductoSucursal"
                                                            data-id="@productoSucursal.IdProductoSucursal"
                                                            onclick="activarEdicion(@productoSucursal.IdProductoSucursal)">
                                                    <i class="bi bi-pencil-square"></i> Update
                                                </button>
                                            </td>



                                            @if (productoSucursal.Producto.Imagen != null)
                                            {

                                                <td>
                                                    <img src="data:image/*;base64,@Convert.ToBase64String(productoSucursal.Producto.Imagen)"
                                                         class="img-fluid rounded img-thumbnail"
                                                         style="max-width: 80px; height: auto;" alt="Img" />
                                                </td>
                                            }
                                            else
                                            {
                                                <td>
                                                    <img src="~/DProduct.jpg"
                                                         class="img-fluid rounded img-thumbnail"
                                                         style="max-width: 80px; height: auto;" alt="Img" />
                                                </td>

                                            }

                                            <td>@productoSucursal.Producto.Nombre</td>
                                            <td>  @productoSucursal.Sucursal.Nombre</td>
                                            <td>
                                                <input type="number"
                                                       id="stock_@productoSucursal.IdProductoSucursal"
                                                       value="@productoSucursal.Stock"       
                                                       readonly="true"
                                                       disabled="true"
                                                       class="form-control"
                                                       style="width: 100%;"/>

                                            </td>
                    
                                            <td>
                                                <button type="button"       
                                                        class="btn btn-success d-none btnUpdateStock-"       
                                                        id="btnGuardarStock-@productoSucursal.IdProductoSucursal"       
                                                        onclick="guardarStock(@productoSucursal.IdProductoSucursal)">
                                                    <i class="bi bi-floppy2"></i>
                                                    Guardar
                                                </button>

                                                <a href="@Url.Action("Delete", "Sucursal", new { IdProducto = productoSucursal.Producto.IdProducto})"
                                                   class="btn btn-danger text-white"
                                                   onclick="return confirm('Estas seguro de que deseas actualizatar el stock a 0 de este producto?');">
                                                    <i class="bi bi-trash"></i>
                                                    Delete
                                                </a>

                                            </td>

                                        </tr>
                                    }

                                </tbody>
                            </table>

                        </div>

                    </div>
                </div>


  
            }
            else
            {
                <div class="col-9">
                    <h2 class="text-bg-light">Selecciona una categoria y una subcategoria para ver los productos</h2>
                </div>


            }
       
        </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/Sucursal.js"></script>

 

<style>
    .sombra:active {
        box-shadow: 2px 2px 15px #076eff inset;
    }
</style>

@using (Html.BeginForm("Form", "Producto", FormMethod.Post, new { enctype = "multipart/form-data", id = "myForm", @class = "needs-validation", @novalidate = "novalidate" }))

{
    <div class="container">
        <div class="row">
            <div class="col-4">
        
                    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

                    @Html.HiddenFor(Model => Model.IdProducto)

                    @Html.LabelFor(Model => Model.Nombre, new { @class = "form-label" })
                @Html.TextBoxFor(Model => Model.Nombre, new { @maxlength = "100", @class = "form-control sombra ", id = "txtNombre", placeholder = "Ingresa el nombre", onkeypress = "validarLetra(this, event)", onblur = "validarLetra(this, event)", required = "required" })
                @Html.ValidationMessageFor(Model => Model.Nombre, "", new { @class = "badge bg-danger" })
                <p class="invalid-feedback" hidden="hidden"></p>
                    <br />

    
                        @Html.LabelFor(Model => Model.Descripcion, new { @class = "form-label" })
                @Html.TextAreaFor(Model => Model.Descripcion, new { @maxlength = "250", @class = "form-control sombra", placeholder = "Ingresa la descripcion"/* , onkeypress = "validarLetra(this, event)", onblur = "validarLetra(this, event)" */ })
                        @*  <p class="invalid-feedback" hidden="hidden"></p>
                    @Html.ValidationMessageFor(Model => Model.Descripcion, "", new { @class = "badge bg-danger" })
 *@


           
            </div>

            <div class="col-4">
                <div>
                    @Html.LabelFor(Model => Model.SubCategoria.Categoria.Nombre, new { @class = "form-label" })
               

                    @Html.DropDownListFor(Model => Model.SubCategoria.Categoria.IdCategoria, new SelectList(Model.SubCategoria.Categoria.Categorias, "IdCategoria", "Nombre"),
                             "Seleccione una categoria", new { @class = "form-control bg-primary text-white", @id = "ddlCategoria", @onchange = "FillSub()", required = "required" })
                    <div class="invalid-feedback">Selecciona una categoria</div>


                    <br />
                @if (Model.SubCategoria.SubCategorias != null)
                {

                    @Html.LabelFor(Model => Model.SubCategoria.Nombre, new { @class = "form-label" })
                    @Html.DropDownListFor(Model => Model.SubCategoria.IdSubCategoria, new SelectList(Model.SubCategoria.SubCategorias, "IdSubCategoria", "Nombre"),
                             "Seleccione una subcategoria", new { @class = "form-control bg-secondary text-white", @id = "ddlSub", required = "required" })
                    <div class="invalid-feedback">Selecciona un municipio</div>

                    @Html.ValidationMessageFor(Model => Model.SubCategoria.IdSubCategoria, "", new { @class = "badge bg-danger" })

                }
                else
                {
                    @Html.LabelFor(Model => Model.SubCategoria.Nombre, new { @class = "form-label" })
                    <i class="bi bi-geo-alt-fill text-primary"></i>
                    @Html.DropDownListFor(Model => Model.SubCategoria.IdSubCategoria, new SelectList(string.Empty, "IdSubCategoria", "Nombre"),
                             "Seleccione una subcategoria", new { @class = "form-control bg-secondary text-white", @id = "ddlSub" })

                }

                  <br />
               
                </div>

            </div>

            <div class="col-4">

                <div>
                    @Html.LabelFor(Model => Model.Precio, new { @class = "form-label" })

                    @Html.TextBoxFor(Model => Model.Precio, new { @maxlength = "10", @class = "form-control sombra", placeholder = "Ingresa el precio", onkeypress = "validarNumero(this, event)", onblur = "validarNumero(this, event)" , required = "required", id = "Precio" })
                    <p class="invalid-feedback" hidden="hidden"></p>

                </div>
                @*                 @Html.ValidationMessageFor(Model => Model.Precio, "", new { @class = "text-danger" })
 *@
             <br />


            </div>
        </div> <br /> <br />
            <div class="row">
                <label for="imagen">Imagen </label>
                <input type="file" id="imagen" name="imagenUser" accept="image/*" onchange="CargarArchivo(event)" class="form-control" />
                <br />

                @Html.HiddenFor(Model => Model.Imagen)
                @if (Model.Imagen != null)
                {
                    <img id="imgInput" class="img-thumbnail" src="data:image/*;base64,@Convert.ToBase64String(Model.Imagen)" style="max-width: 200px; height: auto;" />
                }
                else
                {
                    <img id="imgInput" class="img-thumbnail" src="~/DProduct.jpg" style="max-width: 200px; height: auto;" />
                }
            </div>
            <div class="row">


                <button type="submit" class="btn btn-success" onclick="validar()">
                    <i class="bi bi-floppy2"></i>
                    Guardar informacion
                </button>

            </div>

            <script>

                function validarLetra(input, event) {
                    const regex = /^[A-Za-zäÄëËïÏöÖüÜáéíóúáéíóúÁÉÍÓÚÂÊÎÔÛâêîôûàèìòùÀÈÌÒÙñÑ.-\s]+$/;
                    var letra = event.key;
                    console.log($(input).closest('div'))
                    let errorSpan = $(input).closest('div').find('p')
                    if (event.type == "keypress") {
                        console.log(errorSpan)
                        if (regex.test(letra) && letra.length > 0) {
                            /*   console.log("correcto")
                            $(input).addClass("is-valid");
                            $(input).removeClass("is-invalid");

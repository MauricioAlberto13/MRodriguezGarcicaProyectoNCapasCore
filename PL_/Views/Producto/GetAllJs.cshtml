@model ML.Producto
<link rel="stylesheet" href="~/css/ProductosJS.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<div class="container bg-light py-3">
   
        <div class="row align-items-end">
            <div class="col-12 col-md-3 mb-3">
            <label for="Categoria">Categoria</label>

            @Html.DropDownListFor(Model => Model.SubCategoria.Categoria.IdCategoria,
                     new SelectList(Model.SubCategoria.Categoria.Categorias, "IdCategoria", "Nombre"),
                     "Selecciona una categoria",
                     new { @class = "form-control", @id = "ddlCategoriaBusqueda", @onchange = "FillSubBusqueda()", required = "required" })

                @Html.ValidationMessageFor(Model => Model.SubCategoria.Categoria.IdCategoria, "", new { @class = "badge bg-danger" })
            </div>
            <div class="col-12 col-md-3 mb-3">
            <label for="SubCategoria">SubCategoria</label>
            @Html.DropDownListFor(Model => Model.SubCategoria.IdSubCategoria,
                     new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                     "Seleccione una subcategoría", new { @class = "form-control", @id = "ddlSubBusqueda", required = "required" })
            <div class="invalid-feedback">Selecciona una subcategoría</div>
            @Html.ValidationMessageFor(Model => Model.SubCategoria.IdSubCategoria, "", new { @class = "badge bg-danger" })

            </div>

            <div class="col-12 col-md-3 mb-3 d-flex align-items-end">
                <button type="submit" onclick="buscar()" class="btn btn-primary w-100">
                  @*   <i class="bi bi-search"></i> Buscar *@
                <i class="animation bi bi-search"> Buscar</i><i class="animation"></i>
                </button>
            </div>

            <div class="col-12 col-md-3 mb-3 d-flex align-items-end">
            <button type="button" class="btn btn-success w-100" onclick="showModal()" data-bs-target="#exampleModal">
           @*      Agregar Productos <i class="bi bi-plus-circle"></i> *@

                <i class="animation bi-plus-circle"> Agregar Productos</i><i class="animation"></i>
            </button>
            </div>
        </div>

</div>

<!-- Modal -->
<div class="modal fade" id="modalshow" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Productos</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formr" class="form">
                    <input type="hidden" id="IdProducto">
                    <div class="form-group">
                        <div class="row">
                            <label for="Nombre">Nombre</label>
                            <input type="text" class="input" id="Nombre" required maxlength="100" placeholder="Nombre" onkeypress="validarLetra(this, event)" onblur="validarLetra(this, event)">
                        </div>
                    
                    </div>
         
                    <div class="form-group">
                        <div class="row">
                            <label for="Slogan">Descripcion</label>
                            <textarea name="textarea" cols="30" maxlength="250" class="input" id="Descripcion" placeholder="Descripcion"></textarea>
                        </div>
                    </div>
            
                    <div class="form-group">
                        <div class="row">
                            <label for="Precio">Precio</label>
                            <input type="text" class="input" id="Precio" required maxlength="10" placeholder="Precio" onkeypress="validarNumero(this, event)" onblur="validarNumero(this, event)">
                        </div> 
                    </div>
          
                    <div class="form-group">
                        <div>
                            <div class="row">
                                <label for="Categoria">Categoria</label>
                                @Html.DropDownListFor(Model => Model.SubCategoria.Categoria.IdCategoria, new SelectList(Model.SubCategoria.Categoria.Categorias, "IdCategoria", "Nombre"),
                                         "Seleccione una categoria", new { @class = "form-control ", @id = "ddlCategoriaModal", @onchange = "FillSub()", required = "required" })

                            </div>
                              <div class="row">
                                <label for="SubCategoria">SubCategoria</label>
                                @Html.DropDownListFor(Model => Model.SubCategoria.IdSubCategoria,
                                         new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"),
                                         "Seleccione una subcategoría", new { @class = "form-control", @id = "ddlSubModal", required = "required" })
                                <div class="invalid-feedback">Selecciona una subcategoría</div>
                                @Html.ValidationMessageFor(Model => Model.SubCategoria.IdSubCategoria, "", new { @class = "badge bg-danger" })
                                <label for="imagen">Imagen </label>
                                <input type="file" id="Imagen" name="imagenRestaurante" accept="image/*" onchange="CargarArchivo(event)" class="form-control" />
                                   </div>
                            <br />
                            <div class="row">
                            <div class="text-center">
                                <img id="imgInput" class="rounded img-thumbnail" src="~/DProduct.jpg" style="max-width: 200px; height: auto;" />
                            </div>
                                <input type="hidden" id="hiddenImagen" name="Imagen" />
                        </div>
                        </div>
                    </div> <br />
                    <button type="submit" class="button-confirm">Enviar</button>
                </form>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<div class="container" >
    <div class="row d-flex justify-content-around " id="EFE">
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/js/ProductosJS.js"></script>